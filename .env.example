# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.
STOCKTRACK_ENV=production
# Obligatoria en producción. Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=postgresql://stocktrack:cambia-esta-clave@localhost:5432/stocktrack
COMPANY_NAME=Nombre de la tienda
TIMEZONE=America/Monterrey
MAX_ACTIVE_RECORDS=100000
PAGE_SIZE=25
SESSION_HOURS=8
# Cierre de sesión por inactividad en minutos (0 = desactivado)
SESSION_IDLE_MINUTES=30
# Con HTTPS delante (recomendado) deja la cookie segura; en pruebas locales sin HTTPS ponla en false
SESSION_COOKIE_SECURE=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=300
REPORT_PDF_MAX_ROWS=5000

# Alertas por correo
MAIL_ENABLED=true
MAIL_HOST=smtp.ejemplo.com
MAIL_PORT=587
MAIL_USER=alertas@ejemplo.com
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_FROM=StockTrack <alertas@ejemplo.com>
# Destinatarios fijos adicionales (separados por coma); además reciben los usuarios con "recibir alertas"
ALERT_EMAIL_TO=
